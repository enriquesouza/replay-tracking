{
  "name": "replay-tracking",
  "version": "2.2.0",
  "description": "Decentralized token market (DeFi) replay-tracking smart contract. Tracks content viewing records and rewards users with tokens.",
  "main": "index.js",
  "type": "commonjs",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "start": "node index.js",
    "start:bun": "bun index.js",
    "dev": "nodemon --watch server --watch index.js index.js",
    "dev:bun": "bun --watch index.js",
    "test": "vitest run",
    "test:bun": "bunx vitest run",
    "test:watch": "vitest",
    "compile": "hardhat compile",
    "compile:bun": "bunx hardhat compile",
    "compile:verify": "bash scripts/verify-compile.sh",
    "test:contracts": "hardhat test",
    "test:contracts:bun": "bunx hardhat test",
    "test:contracts:gas": "REPORT_GAS=true hardhat test",
    "test:contracts:coverage": "hardhat coverage",
    "node:hardhat": "hardhat node",
    "node:hardhat:bun": "bunx hardhat node",
    "node:anvil": "anvil --host 0.0.0.0 --port 8545",
    "node:stop": "pkill -f 'hardhat node' || true; pkill -f anvil || true",
    "deploy:local": "node scripts/deploy-contract-local.js",
    "deploy:anvil": "node scripts/deploy-contract-anvil.js",
    "deploy:prod": "node scripts/deploy-contract-prod.js",
    "deploy:verify": "node scripts/deploy-contract-verify.js",
    "health:rpc": "node scripts/health-check.js",
    "balance:check": "node scripts/check-balance.js",
    "foundry:build": "forge build",
    "foundry:test": "forge test",
    "foundry:fmt": "forge fmt",
    "foundry:install": "bash -c \"curl -L https://foundry.paradigm.xyz | bash && foundryup\"",
    "bun:install": "curl -fsSL https://bun.sh/install | bash",
    "python:setup": "bash scripts/python-setup.sh",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "lint:bun:sol": "bunx solhint 'contracts/**/*.sol'",
    "lint:js": "eslint .",
    "lint:bun:js": "bunx eslint .",
    "lint": "npm run lint:sol && npm run lint:js",
    "lint:bun": "bun run lint:bun:sol && bun run lint:bun:js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=moderate",
    "audit:bun": "bun audit",
    "install:bun": "bun install --frozen-lockfile",
    "install:npm": "npm ci",
    "prepare": "husky"
  },
  "author": "Enrique Souza",
  "dependencies": {
    "@fastify/compress": "^7.0.3",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@google-cloud/bigquery": "^7.9.0",
    "@openzeppelin/contracts": "^5.6.1",
    "axios": "^1.7.2",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "fastify": "^4.28.1",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.14",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": "^9.1.0",
    "@types/node": "^20.0.0",
    "chai": "^4.2.0",
    "commitlint": "^19.0.0",
    "eslint": "^9.10.0",
    "globals": "^15.0.0",
    "hardhat": "^2.28.6",
    "hardhat-gas-reporter": "^2.3.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.0",
    "prettier-plugin-solidity": "^1.3.0",
    "solhint": "^5.1.0",
    "solidity-coverage": "^0.8.17",
    "supertest": "^7.0.0",
    "ts-node": ">=8.0.0",
    "typechain": "^8.3.0",
    "typescript": ">=4.5.0",
    "vitest": "^2.0.4"
  },
  "lint-staged": {
    "!(*.test).{js,ts}": [
      "prettier --write",
      "eslint --no-warn-ignored --max-warnings=50"
    ],
    "*.test.js": [
      "prettier --write",
      "eslint --no-warn-ignored --max-warnings=50"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ],
    "*.sol": [
      "prettier --write",
      "solhint --max-warnings=30 'contracts/**/*.sol'"
    ]
  },
  "overrides": {
    "fastify": "^4.28.1",
    "cookie": "^0.7.0"
  }
}
