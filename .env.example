# --- Server ---
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false

# --- Auth ---
# Set X_API_KEY in production. Generate with: openssl rand -hex 32
X_API_KEY=
# Optional JWT. If JWT_SECRET is set, requests with `Authorization: Bearer <token>`
# are accepted in addition to (or instead of) x-api-key.
JWT_SECRET=
# If you use JWT, this is the public cookie secret used to sign cookies.
COOKIE_SECRET=

# --- CORS ---
# Comma-separated list of allowed origins. Leave empty in dev to allow all.
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Comma-separated list of IPs that bypass the rate limiter.
RATE_LIMIT_ALLOWLIST=

# --- Blockchain ---
# RPC URL for the chain the API talks to.
RPC_URL=https://curtis.rpc.caldera.xyz/http
# Private key of the EOA that broadcasts admin transactions.
# In production, this should be a KMS-managed key. NEVER commit it.
DEPLOYER_PRIVATE_KEY=
# Address of the deployed ReplayTrackingContractV3.
CONTRACT_ADDRESS=
# Etherscan / Blockscout API key (for `deploy:verify`).
ETHERSCAN_API_KEY=
# Optional: API for gas-price oracle (used by gas reporter).
GAS_PRICE_API=

# --- Local node ---
LOCAL_RPC_URL=http://127.0.0.1:8545

# --- Camp Network testnet ---
CAMP_RPC_URL=https://rpc.camp-network-testnet.gelato.digital

# --- Foundry (for `anvil --fork-url`) ---
FORK_URL=
